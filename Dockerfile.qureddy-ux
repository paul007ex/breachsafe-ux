# syntax=docker/dockerfile:1
#
# qureddy-ux: a SELF-CONTAINED EnXemble host for QuReddy. Built FROM the official, multi-arch
# qureddy image (qureddy + python + openssl already inside), then adds the EnXemble web host and
# the TLS/SSH descriptors. One command, no docker socket, any arch:
#   docker run -p 7860:7860 ghcr.io/paul007ex/qureddy-ux
# qureddy is on PATH here, so scans run in-process (the descriptors' run.image is just a fallback).
FROM ghcr.io/breachsafe/qureddy:latest

USER root
# ssh-keyscan for the SSH tab's "Test connection" action (openssl for TLS is already in the base)
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*
# add the EnXemble host (gradio + engine) on top of the qureddy tool image
COPY dist/breachsafe_ux-*.whl /tmp/
RUN pip install --no-cache-dir /tmp/breachsafe_ux-*.whl && rm -f /tmp/*.whl

# ship the OSS descriptors (Quantum Audit + SSH Audit)
COPY tools/qureddy      /opt/enxemble/tools/qureddy
COPY tools/qureddy-ssh  /opt/enxemble/tools/qureddy-ssh

ENV BREACHSAFE_UX_TOOLS_DIR=/opt/enxemble/tools \
    BREACHSAFE_UX_MINT_OSCAL=false \
    BREACHSAFE_UX_HOST=0.0.0.0 \
    BREACHSAFE_UX_PORT=7860 \
    GRADIO_ANALYTICS_ENABLED=False

EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7860/', timeout=4).status == 200 else 1)"]
ENTRYPOINT ["breachsafe-ux"]
