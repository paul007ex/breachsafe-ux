# SPDX-FileCopyrightText: 2026 BreachSAFE <https://www.breachsafe.io>
# SPDX-License-Identifier: Apache-2.0
# syntax=docker/dockerfile:1
#
# qureddy-ux: a SELF-CONTAINED EnXemble host for QuReddy. Built FROM the official, multi-arch
# qureddy image (qureddy + python + openssl already inside), then adds the EnXemble web host and
# the TLS/SSH descriptors. One command, no docker socket, any arch:
#   docker run -p 7860:7860 ghcr.io/paul007ex/qureddy-ux
# qureddy is on PATH here, so scans run in-process (the descriptors' run.image is just a fallback).
# Base image digest-pinned (#119) — tag comment kept for humans; the digest is authoritative.
# Track the qureddy release stream, deliberately UNPINNED. README §6 says to pin by digest
# "when reproducibility matters more than freshness" — here freshness wins: this image exists
# to put the current scanner in front of a user, and a stale pin silently shipped qureddy
# 0.2.34 (Python 3.12) for six releases while upstream reached 0.2.40 (Python 3.14) (#138).
# The scheduled rebuild in qureddy-ux-image.yml is what makes ":latest" mean latest — without
# it this file only rebuilds when ux itself changes, so a qureddy release would never land.
# Reproducibility is preserved by the per-release qureddy-ux tags, which are immutable.
FROM ghcr.io/breachsafe/qureddy:latest
LABEL org.opencontainers.image.title="qureddy-ux" \
      org.opencontainers.image.vendor="BreachSAFE" \
      org.opencontainers.image.source="https://github.com/paul007ex/breachsafe-ux" \
      org.opencontainers.image.description="qureddy-ux — self-contained EnXemble host for QuReddy (TLS/SSH audit)" \
      org.opencontainers.image.base.name="ghcr.io/breachsafe/qureddy"

USER root
# ssh-keyscan for the SSH tab's "Test connection" action (openssl for TLS is already in the base)
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client \
    && rm -rf /var/lib/apt/lists/*
# add the EnXemble host (gradio + engine) on top of the qureddy tool image
COPY dist/breachsafe_ux-*.whl /tmp/
RUN pip install --no-cache-dir /tmp/breachsafe_ux-*.whl && rm -f /tmp/*.whl \
    # Drop the installer from the RUNTIME image. pip is needed for the line above and never
    # again: ENTRYPOINT is breachsafe-ux and the healthcheck is plain urllib. Its vendored tree
    # is where Trivy finds msgpack GHSA-6v7p-g79w-8964 and setuptools CVE-2025-47273, both
    # inherited from python:3.14-slim-bookworm rather than declared by us (breachsafe/qureddy#382).
    # Deleting unused code beats excusing it with an ignore file, and it shrinks the image.
    && pip uninstall -y pip setuptools 2>/dev/null || true; \
    rm -rf /usr/local/lib/python3.14/site-packages/pip \
           /usr/local/lib/python3.14/site-packages/pip-*.dist-info \
           /usr/local/lib/python3.14/site-packages/setuptools \
           /usr/local/lib/python3.14/site-packages/setuptools-*.dist-info \
           /usr/local/lib/python3.14/site-packages/pkg_resources \
           /usr/local/bin/pip /usr/local/bin/pip3 /usr/local/bin/pip3.14

# ship the OSS descriptors (HNDL Audit: TLS + SSH)
COPY tools/qureddy      /opt/enxemble/tools/qureddy
COPY tools/qureddy-ssh  /opt/enxemble/tools/qureddy-ssh

ENV BREACHSAFE_UX_TOOLS_DIR=/opt/enxemble/tools \
    BREACHSAFE_UX_MINT_OSCAL=false \
    BREACHSAFE_UX_HOST=0.0.0.0 \
    BREACHSAFE_UX_PORT=7860 \
    GRADIO_ANALYTICS_ENABLED=False

EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7860/', timeout=4).status == 200 else 1)"]
ENTRYPOINT ["breachsafe-ux"]
