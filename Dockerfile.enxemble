# SPDX-FileCopyrightText: 2026 BreachSAFE <https://www.breachsafe.io>
# SPDX-License-Identifier: Apache-2.0
# syntax=docker/dockerfile:1
#
# enxemble: a self-contained EnXemble host for QuReddy. Built FROM the official, multi-arch
# qureddy image (qureddy + python + openssl already inside), then adds the EnXemble web host and
# the TLS/SSH descriptors. One command, no docker socket, any arch:
#   docker run -p 7860:7860 ghcr.io/breachsafe/enxemble
# qureddy is on PATH here, so scans run in-process (the descriptors' run.image is just a fallback).
# Base image digest-pinned (#119) — tag comment kept for humans; the digest is authoritative.
# Track the qureddy release stream, deliberately UNPINNED. README §6 says to pin by digest
# "when reproducibility matters more than freshness" — here freshness wins: this image exists
# to put the current scanner in front of a user, and a stale pin silently shipped qureddy
# 0.2.34 for six releases while upstream reached 0.2.40 (#138).
# The scheduled rebuild in enxemble-image.yml is what makes ":latest" mean latest — without
# it this file only rebuilds when ux itself changes, so a QuReddy release would never land.
# Reproducibility is preserved by the per-release EnXemble tags, which are immutable.
# ---- builder stage: install the EnXemble host wheel where pip still exists ----
# The qureddy base runtime ships NO pip/setuptools (breachsafe/qureddy#385), so the host
# wheel + its deps are installed here (same digest-pinned python as the qureddy base, so the
# site-packages ABI matches) and COPYed into the final image. qureddy itself comes from the
# base image — never pip/TestPyPI.
# Temporary cross-organization dependency: Evidence is still published from the existing
# breachsafe-evidence-go image until that repository/package is ported to the BreachSAFE org.
ARG EVIDENCE_IMAGE=ghcr.io/paul007ex/breachsafe-evidence-go:latest
ARG ENXEMBLE_VERSION=0.9.0
FROM python:3.14-slim-bookworm AS ux-builder
COPY dist/breachsafe_ux-*.whl /tmp/
RUN set -eux; \
    test "$(ls -1 /tmp/breachsafe_ux-*.whl | wc -l)" -eq 1; \
    pip install --no-cache-dir --prefix=/install /tmp/breachsafe_ux-*.whl; \
    # Preserve the base's pip-free / Trivy posture (#382): drop any build tooling a dep dragged in.
    rm -rf /install/lib/python3.14/site-packages/pip* \
           /install/lib/python3.14/site-packages/setuptools* \
           /install/lib/python3.14/site-packages/pkg_resources \
           /install/bin/pip /install/bin/pip3 /install/bin/pip3.14

# The OSS customer image carries the evidence facade, the official ePack executable it delegates
# to, and the PDF renderer. The facade verifies both bundled digests before it runs.
FROM ${EVIDENCE_IMAGE} AS evidence

ARG ENXEMBLE_VERSION=0.9.0
FROM ghcr.io/breachsafe/qureddy:latest
ARG ENXEMBLE_VERSION
LABEL org.opencontainers.image.title="BreachSAFE EnXemble" \
      org.opencontainers.image.vendor="BreachSAFE" \
      org.opencontainers.image.source="https://github.com/breachsafe/enxemble" \
      org.opencontainers.image.version="${ENXEMBLE_VERSION}" \
      org.opencontainers.image.description="BreachSAFE EnXemble — self-contained QuReddy TLS/SSH audit and evidence host" \
      org.opencontainers.image.base.name="ghcr.io/breachsafe/qureddy"

USER root
# ssh-keyscan for the SSH tab's "Test connection" action (openssl for TLS is already in the base)
RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-client poppler-utils \
    && rm -rf /var/lib/apt/lists/*
# add the EnXemble host (gradio + engine) on top of the qureddy tool image.
# Installed in the ux-builder stage (the qureddy base has no pip, #385); COPY the resolved tree
# into the base's /usr/local (site-packages + console scripts). No pip ever runs in this image.
COPY --from=ux-builder /install /usr/local
# Evidence export is fully self-contained: no Docker socket and no runtime download.
COPY --from=evidence /usr/local/bin/breachsafe-evidence /usr/local/bin/breachsafe-evidence
COPY --from=evidence /usr/local/bin/epack /usr/local/bin/epack
COPY --from=evidence /usr/share/breachsafe/epack.sha256 /usr/share/breachsafe/epack.sha256
COPY --from=evidence /usr/share/breachsafe/epack.revision /usr/share/breachsafe/epack.revision
COPY --from=evidence /usr/share/licenses/epack /usr/share/licenses/epack
COPY --from=evidence /usr/local/bin/breachsafe-pdf /usr/local/bin/breachsafe-pdf
COPY --from=evidence /usr/share/breachsafe/breachsafe-pdf.sha256 /usr/share/breachsafe/breachsafe-pdf.sha256
COPY --from=evidence /usr/share/licenses/breachsafe-pdf /usr/share/licenses/breachsafe-pdf
# Fail closed if the host didn't actually land (an earlier `|| true` once shipped an app-less image).
RUN set -eux; \
    python3 -c "import breachsafe_ux"; \
    command -v breachsafe-ux; \
    command -v breachsafe-evidence; \
    command -v epack; \
    command -v breachsafe-pdf; \
    test -s /usr/share/breachsafe/epack.sha256; \
    test -s /usr/share/breachsafe/breachsafe-pdf.sha256; \
    expected_sha256=$(awk 'NF {print $1; exit}' /usr/share/breachsafe/breachsafe-pdf.sha256); \
    test "${#expected_sha256}" -eq 64; \
    actual_sha256=$(sha256sum /usr/local/bin/breachsafe-pdf | awk '{print $1}'); \
    test "${actual_sha256}" = "${expected_sha256}"

# ship the OSS descriptors (HNDL Audit: TLS + SSH)
COPY tools/qureddy      /opt/enxemble/tools/qureddy
COPY tools/qureddy-ssh  /opt/enxemble/tools/qureddy-ssh

ENV BREACHSAFE_UX_TOOLS_DIR=/opt/enxemble/tools \
    BREACHSAFE_EPACK_BIN=/usr/local/bin/epack \
    BREACHSAFE_PDF_BIN=/usr/local/bin/breachsafe-pdf \
    BREACHSAFE_UX_BUILD_VERSION=${ENXEMBLE_VERSION} \
    BREACHSAFE_UX_MINT_OSCAL=false \
    BREACHSAFE_UX_HOST=0.0.0.0 \
    BREACHSAFE_UX_PORT=7860 \
    GRADIO_ANALYTICS_ENABLED=False \
    HOME=/home/breachsafe

# The web host launches scanner subprocesses and serves generated artifacts. Keep that
# runtime boundary non-root even though the image assembly above needs root for apt/copies.
RUN groupadd --system --gid 10001 breachsafe \
    && useradd --system --uid 10001 --gid breachsafe --create-home --home-dir /home/breachsafe \
       --shell /usr/sbin/nologin breachsafe \
    && install -d -o breachsafe -g breachsafe /home/breachsafe/mint-proof/wizard-runs \
    && chown -R breachsafe:breachsafe /opt/enxemble
USER breachsafe

EXPOSE 7860
HEALTHCHECK --interval=30s --timeout=5s --start-period=25s --retries=3 \
  CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:7860/', timeout=4).status == 200 else 1)"]
ENTRYPOINT ["breachsafe-ux"]
