# Per-Dockerfile ignore (BuildKit) for the qureddy-ux consumer image. Keeps dist/ (the host
# wheel this image installs) and tools/qureddy + tools/qureddy-ssh (the OSS descriptors); drops
# the Enterprise mint-oscal descriptor and local bin shims.
.git
.github
.gitignore
.venv
build
.ruff_cache
.mypy_cache
**/__pycache__
*.pyc
.claude
.agents
.playwright-cli
tests
docs
tools/mint-oscal
tools/*/bin
*.egg-info
